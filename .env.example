# Database
# Production/staging uses Neon (serverless PostgreSQL). Use the POOLED
# connection string (host contains "-pooler") as DATABASE_URL and the DIRECT
# connection string as DIRECT_URL. Add "?sslmode=require" (Neon requires TLS).
DATABASE_URL="postgresql://neondb_owner:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://neondb_owner:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"
# Local fallback example (docker compose):
# DATABASE_URL="postgresql://elbannawy:elbannawy_dev@localhost:5432/elbannawy_platform"
# DIRECT_URL="postgresql://elbannawy:elbannawy_dev@localhost:5432/elbannawy_platform"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=change-me-to-a-secure-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookie signing secret (signed refresh-token cookies). REQUIRED in production.
COOKIE_SECRET=change-me-to-a-secure-random-string

# OAuth – Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# OAuth – Apple
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/apple/callback

# Frontend URL (for OAuth redirects)
FRONTEND_URL=http://localhost:3000

# CORS allowed origins (comma-separated). In production, set this to the exact
# frontend origin(s). Localhost defaults are added automatically in development.
CORS_ORIGINS=

# File storage — Cloudflare R2 (Optional)
# When all four R2_* variables are set, uploaded files (lesson documents,
# saved documents, certificates, UI images) are stored in Cloudflare R2 via
# the S3-compatible API. When unset, files fall back to local disk (uploads/).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# AI (Optional - leave empty to use rule-based fallback)
AI_API_KEY=
AI_ENDPOINT=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
# Server-side AES-256-GCM key used to encrypt AI provider API keys at rest.
# MUST be identical across all processes (backend, seed, migrations) or stored keys become undecryptable.
AI_ENCRYPTION_KEY=

# OpenCode Zen — OpenAI-compatible provider (DeepSeek V4 Flash Free)
# Required only when the OpenCode provider is enabled. Backend-only; never expose to the frontend.
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_DEFAULT_MODEL=deepseek-v4-flash-free

# Firebase (Optional - get from Firebase Console)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Firebase Admin (service account) — used by the backend for FCM push AND
# verifying Firebase Authentication ID tokens (email login/register).
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Email (Brevo - transactional email for the verification-code flow)
# Sign up at https://brevo.com and get an API v3 key + verified sender.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=El-bannawy Platform

# Payments – Public base URL used in gateway redirect/callback links
PUBLIC_BASE_URL=http://localhost:4000

# Payments – Webhook signature secret (POST /api/v1/webhooks/payments)
# REQUIRED. Application will not start without it.
PAYMENT_WEBHOOK_SECRET=change-me-to-a-secure-random-string

# Payments – Simulation mode HMAC key (for dev/test payment flows)
# Required if using simulated gateways. Set a random 32+ char string.
SIMULATION_HMAC_KEY=dev-simulation-key-change-me

# Payments – Paymob (leave empty to use simulation mode)
PAYMOB_API_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_MERCHANT_ID=
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_INTEGRATION_IDS=

# Payments – Fawry (leave empty to use simulation mode)
FAWRY_MERCHANT_CODE=
FAWRY_SECURITY_KEY=
FAWRY_BASE_URL=https://developer.fawrystaging.com

# Payments – Instapay (leave empty to use simulation mode)
INSTAPAY_API_KEY=
INSTAPAY_BASE_URL=https://ipn.eg

# Payments – Vodafone Cash (leave empty to use simulation mode)
VODAFONE_CASH_MERCHANT_ID=
VODAFONE_CASH_SECRET=
VODAFONE_CASH_BASE_URL=

# Payments – Orange Cash (leave empty to use simulation mode)
ORANGE_CASH_MERCHANT_ID=
ORANGE_CASH_SECRET=
ORANGE_CASH_BASE_URL=

# Payments – Etisalat Cash (leave empty to use simulation mode)
ETISALAT_CASH_MERCHANT_ID=
ETISALAT_CASH_SECRET=
ETISALAT_CASH_BASE_URL=

# Zoom Meeting SDK (Live sessions)
# Meeting SDK app credentials: used to generate the in-browser signature.
# Either the Meeting SDK Key/Secret pair or the OAuth Client ID/Secret is required.
ZOOM_SDK_KEY=
ZOOM_SDK_SECRET=

# Zoom OAuth app (account-level, client-credentials) — required to create/manage
# meetings through the REST API and to sign SDK signatures when SDK credentials are absent.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Optional Zoom overrides
ZOOM_OAUTH_BASE_URL=https://zoom.us/oauth/token
ZOOM_API_BASE_URL=https://api.zoom.us/v2
ZOOM_SDK_SIGNATURE_URL=https://zoom.us/sdk/signature
ZOOM_SIGNATURE_TTL_SECONDS=7200

# Zoom Web SDK version loaded lazily by the frontend
NEXT_PUBLIC_ZOOM_SDK_VERSION=1.9.9
NEXT_PUBLIC_ZOOM_SDK_STAGING=false


