{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "pnpm --filter @el-bannawy/shared build && pnpm --filter @el-bannawy/web build",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": ".next",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://el-bannawy-backend-production.up.railway.app/api/:path*"
    },
    {
      "source": "/files/:path*",
      "destination": "https://el-bannawy-backend-production.up.railway.app/files/:path*"
    }
  ]
}
