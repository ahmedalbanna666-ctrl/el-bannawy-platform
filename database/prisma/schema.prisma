generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  // shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

/// Represents a platform user (student, teacher, admin, staff, support, secretary)
model User {
  id                          String                   @id @default(uuid()) @db.Uuid
  fullName                    String
  englishName                 String?
  email                       String?                  @unique
  mobileNumber                String?                  @unique
  parentMobile                String?
  /// bcrypt hash (60 chars). Null for OAuth-only accounts
  passwordHash                String?
  googleId                    String?                  @unique
  appleId                     String?                  @unique
  /// Firebase Authentication UID for Firebase-backed accounts
  firebaseUid                 String?                  @unique
  /// Set when the registered email has been confirmed
  emailVerifiedAt             DateTime?
  /// Values: "google", "apple", or null
  oauthProvider               String?
  role                        UserRole
  status                      AccountStatus            @default(PENDING_VERIFICATION)
  educationalSystem           String?
  /// Deprecated: use gradeId + assignedGrade relation instead
  educationalStage            String?
  /// Deprecated: use gradeId + assignedGrade relation instead
  grade                       String?
  /// Deprecated: use termId relation instead
  academicTerm                String?
  governorate                 String?
  school                      String?
  academicYearId              String?                  @db.Uuid
  termId                      String?                  @db.Uuid
  gradeId                     String?                  @db.Uuid
  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime                 @updatedAt
  deletedAt                   DateTime?
  activityProgress            ActivityProgress[]
  attendance                  AttendanceRecord[]
  coinWallet                  CoinWallet?
  conversations               Conversation[]
  lessonProgress              LessonProgress[]
  loginHistory                LoginHistory[]
  notificationPreferences     NotificationPreference?
  notifications               Notification[]
  passwordResets              PasswordReset[]
  emailVerifications          EmailVerification[]
  payments                    Payment[]
  quizAttempts                QuizAttempt[]
  refreshTokens               RefreshToken[]
  sessions                    Session[]
  homeworkAttempts            StudentHomeworkAttempt[]
  achievements                UserAchievement[]
  unitCertificates            UnitCertificate[]
  videoProgress               VideoProgress[]
  xpTransactions              XPTransaction[]
  academicYear                AcademicYear?            @relation(fields: [academicYearId], references: [id])
  term                        Term?                    @relation(fields: [termId], references: [id])
  assignedGrade               Grade?                   @relation(fields: [gradeId], references: [id])
  teacherGrades               TeacherGrade[]
  auditLogs                   AuditLog[]
  managedByTeacherId          String?                  @db.Uuid
  managedByTeacher            User?                    @relation("TeacherManagesStaff", fields: [managedByTeacherId], references: [id])
  managedStaff                User[]                   @relation("TeacherManagesStaff")
  permissionGrants            UserPermissionGrant[]    @relation("PermissionHolder")
  grantedPermissions          UserPermissionGrant[]    @relation("PermissionGrantor")
  permissionsInitialized      Boolean                  @default(false)
  avatarUrl                   String?
  jobTitle                    String?
  liveSessionsAsTeacher       LiveSession[]            @relation("LiveSessionsAsTeacher")
  liveBookings                LiveBooking[]            @relation("LiveBookingStudent")
  liveAttendanceRecords       LiveAttendance[]         @relation("LiveAttendanceStudent")
  liveAttendanceMarked        LiveAttendance[]         @relation("LiveAttendanceMarker")
  liveSubscriptions           LiveSubscription[]       @relation("LiveSubscriptionHolder")
  liveSubscriptionsAsTeacher  LiveSubscription[]       @relation("LiveSubscriptionTeacher")
  liveWaitingListEntries      LiveWaitingList[]        @relation("LiveWaitingListStudent")
  liveRescheduleDecisions     LiveBooking[]            @relation("LiveBookingRescheduleResolver")
  liveRefunds                 LiveRefund[]             @relation("LiveRefundUser")
  liveRefundsProcessed        LiveRefund[]             @relation("LiveRefundProcessor")
  teacherAvailabilities       TeacherAvailability[]    @relation("TeacherAvailabilityTeacher")
  studySchedules              StudySchedule[]          @relation("StudyScheduleTeacher")
  teacherDateBlocks           TeacherDateBlock[]       @relation("TeacherDateBlockTeacher")
  teacherLiveSettings         TeacherLiveSettings?
  liveAnnouncements           LiveAnnouncement[]       @relation("LiveAnnouncementSender")
  liveSessionControlLogs      LiveSessionControlLog[]  @relation("LiveSessionControlActor")
  assessmentAttempts          AssessmentAttempt[]
  coinPurchases               CoinPurchase[]
  miniExams                   MiniExam[]               @relation("MiniExamUser")
  competitionsCreated         Competition[]            @relation("CompetitionCreator")
  competitionParticipations   CompetitionParticipant[] @relation("CompetitionParticipantStudent")
  codesCreated                UnlockCode[]             @relation("UnlockCodeCreator")
  codeRedemptions             CodeRedemption[]
  contentUnlocks              ContentUnlock[]
  unlockRequests              UnlockRequest[]          @relation("UnlockRequestRequester")
  savedDocuments              SavedDocument[]
  resolvedUnlockRequests      UnlockRequest[]          @relation("UnlockRequestResolver")
  supportTicketsCreated       SupportTicket[]          @relation("SupportTicketCreator")
  supportTicketsAssigned      SupportTicket[]          @relation("SupportTicketAgent")
  supportMessages             SupportMessage[]         @relation("SupportMessageSender")
  videoQuestionAnswers        VideoQuestionAnswer[]
  manualPaymentOrders         ManualPaymentOrder[]
  reviewedManualPaymentOrders ManualPaymentOrder[]     @relation("ManualPaymentReviewer")
  studentAiCredits            StudentAiCredits?
  aiUsageLogs                 AiUsageLog[]
  aiFeedback                  AiFeedback[]
  aiPromptTemplates           AiPromptTemplate[] @relation("PromptTemplateAuthor")
  deviceTokens                DeviceToken[]
  referralCode                ReferralCode?
  referralsMade               Referral[]         @relation("ReferralReferrer")
  referralsReceived           Referral[]         @relation("ReferralReferred")
  referralCampaignsCreated    ReferralCampaign[] @relation("ReferralCampaignCreator")
  referralCampaignViews       ReferralCampaignView[]
  pronunciationAttempts       PronunciationAttempt[]

  @@index([mobileNumber])
  @@index([role])
  @@index([status])
  @@index([managedByTeacherId])
  @@index([academicYearId])
  @@index([termId])
  @@index([gradeId])
  @@index([deletedAt])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  deviceId  String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@index([deviceId])
  @@map("sessions")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  token     String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model LoginHistory {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  ipAddress     String?
  userAgent     String?
  success       Boolean
  failureReason String?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("login_history")
}

model PasswordReset {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  verificationCode String
  expiresAt        DateTime
  usedAt           DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([verificationCode])
  @@map("password_resets")
}

model EmailVerification {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  email            String
  verificationCode String
  expiresAt        DateTime
  usedAt           DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([verificationCode])
  @@map("email_verifications")
}

model XPTransaction {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  amount    Int
  reason    String
  reference String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("xp_transactions")
}

model CoinWallet {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("coin_wallets")
}

/// Represents a payment transaction (coins purchase, lesson unlock, etc.)
model Payment {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @db.Uuid
  /// Values: "COINS", "LESSON", "UNIT", "LIVE_*"
  productType     String
  /// ID of the purchased product (coin package, lesson, unit, schedule, subscription)
  productId       String
  amount          Int
  /// ISO 4217 currency code
  currency        String    @default("EGP")
  /// Values: "paymob", "fawry", "instapay", "TEST"
  paymentMethod   String
  /// Lifecycle: PENDING -> SUCCESSFUL/FAILED -> REFUNDED | AWAITING_APPROVAL -> SUCCESSFUL/REJECTED
  status          String    @default("PENDING")
  /// Reference from the payment gateway
  gatewayRef      String?
  gatewayResponse String?
  /// Live booking context (scheduleId, dayIds, subscriptionType, dateFrom, dateTo)
  metadata        Json?
  /// Instapay manual proof fields
  proofGatewayRef      String?
  proofSenderNumber    String?
  proofTransactionRef  String?
  proofScreenshot      String?
  adminNote            String?
  reviewedById         String?   @db.Uuid
  reviewedAt           DateTime?
  couponId        String?   @db.Uuid
  discount        Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  completedAt     DateTime?
  invoice         Invoice?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon          Coupon?   @relation(fields: [couponId], references: [id], onDelete: SetNull)
  liveRefunds     LiveRefund[]

  @@index([userId])
  @@index([userId, status])
  @@index([status])
  @@index([createdAt])
  @@index([productType, productId])
  @@index([paymentMethod])
  @@index([completedAt])
  @@map("payments")
}

model Invoice {
  id        String   @id @default(uuid()) @db.Uuid
  paymentId String   @unique @db.Uuid
  number    String   @unique
  createdAt DateTime @default(now())
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

model Coupon {
  id                 String    @id @default(uuid()) @db.Uuid
  code               String    @unique
  discountType       String    @default("PERCENTAGE")
  discountValue      Int
  maxUses            Int?
  usedCount          Int       @default(0)
  expiresAt          DateTime?
  applicableProducts String?
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  payments Payment[]

  @@map("coupons")
}

model CoinPackage {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  coinAmount  Int
  price       Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchases           CoinPurchase[]
  manualPaymentOrders ManualPaymentOrder[]

  @@map("coin_packages")
}

model CoinPurchase {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String      @db.Uuid
  packageId  String      @db.Uuid
  coinAmount Int
  price      Int
  paymentId  String?     @db.Uuid
  status     String      @default("COMPLETED")
  createdAt  DateTime    @default(now())
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  package    CoinPackage @relation(fields: [packageId], references: [id])

  @@index([userId])
  @@map("coin_purchases")
}

model UnlockCode {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @unique
  coinAmount  Int
  maxUses     Int?
  usedCount   Int       @default(0)
  active      Boolean   @default(true)
  expiresAt   DateTime?
  targetType  String? // "UNIT" | "LESSON" | null (null = coins-only code)
  targetId    String?   @db.Uuid
  createdById String    @db.Uuid
  createdBy   User      @relation("UnlockCodeCreator", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  redemptions CodeRedemption[]

  @@index([code])
  @@map("unlock_codes")
}

model CodeRedemption {
  id         String     @id @default(uuid()) @db.Uuid
  codeId     String     @db.Uuid
  userId     String     @db.Uuid
  coinAmount Int
  redeemedAt DateTime   @default(now())
  code       UnlockCode @relation(fields: [codeId], references: [id])
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([codeId, userId])
  @@index([userId])
  @@map("code_redemptions")
}

model ContentUnlock {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  targetType   String
  targetId     String   @db.Uuid
  unlockMethod String
  coinAmount   Int?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([userId])
  @@index([targetType, targetId])
  @@map("content_unlocks")
}

model UnlockRequest {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  targetType   String
  targetId     String    @db.Uuid
  status       String    @default("PENDING")
  adminNote    String?
  resolvedById String?   @db.Uuid
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation("UnlockRequestRequester", fields: [userId], references: [id], onDelete: Cascade)
  resolvedBy   User?     @relation("UnlockRequestResolver", fields: [resolvedById], references: [id])

  @@index([userId])
  @@index([status])
  @@map("unlock_requests")
}

model ReferralCode {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @unique @db.Uuid
  code      String     @unique
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  referrals Referral[]

  @@index([code])
  @@map("referral_codes")
}

model Referral {
  id              String    @id @default(uuid()) @db.Uuid
  referrerId      String    @db.Uuid
  referredId      String    @db.Uuid
  codeId          String    @db.Uuid
  campaignId      String?   @db.Uuid
  status          String    @default("PENDING")
  purchasedType   String?
  purchasedAmount Int?
  rewardCoins     Int       @default(0)
  approvedAt      DateTime?
  rejectedAt      DateTime?
  createdAt       DateTime  @default(now())
  referrer        User      @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred        User      @relation("ReferralReferred", fields: [referredId], references: [id], onDelete: Cascade)
  code            ReferralCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  campaign        ReferralCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@unique([referredId])
  @@index([referrerId])
  @@index([status])
  @@map("referrals")
}

model ReferralCampaign {
  id                String    @id @default(uuid()) @db.Uuid
  title             String
  message           String
  active            Boolean   @default(true)
  targetStageId     String?   @db.Uuid
  targetGradeId     String?   @db.Uuid
  maxViewsPerDay    Int       @default(1)
  showDaysPerWeek   String    @default("[0,1,2,3,4,5,6]")
  unitRewardPercent Int       @default(5)
  termRewardPercent Int       @default(10)
  startsAt          DateTime?
  endsAt            DateTime?
  createdById         String    @db.Uuid
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  createdBy           User      @relation("ReferralCampaignCreator", fields: [createdById], references: [id])
  views               ReferralCampaignView[]
  referrals           Referral[]

  @@index([active])
  @@map("referral_campaigns")
}

model ReferralCampaignView {
  id         String           @id @default(uuid()) @db.Uuid
  campaignId String           @db.Uuid
  userId     String           @db.Uuid
  viewedAt   DateTime         @default(now())
  campaign   ReferralCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([campaignId, userId])
  @@index([userId])
  @@map("referral_campaign_views")
}

model UserAchievement {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  type        String
  title       String
  description String?
  icon        String?
  earnedAt    DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
  @@map("user_achievements")
}

model UnitCertificate {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  unitId           String   @db.Uuid
  fileName         String
  fileUrl          String
  fileSize         Int      @default(0)
  mimeType         String   @default("application/pdf")
  /// Public code used for online verification (QR), e.g. "EB-XXXX-XXXX".
  verificationCode String?  @unique @db.VarChar(32)
  earnedAt         DateTime @default(now())
  unit             Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, unitId])
  @@index([userId])
  @@map("unit_certificates")
}

model LessonProgress {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  lessonId    String    @db.Uuid
  completed   Boolean   @default(false)
  progress    Float     @default(0)
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
  @@map("lesson_progress")
}

model AttendanceRecord {
  id      String   @id @default(uuid()) @db.Uuid
  userId  String   @db.Uuid
  date    DateTime @default(now())
  present Boolean  @default(true)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@map("attendance_records")
}

model Stage {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  grades       Grade[]

  @@index([displayOrder])
  @@map("stages")
}

model Grade {
  id                    String                @id @default(uuid()) @db.Uuid
  name                  String
  stageId               String                @db.Uuid
  displayOrder          Int                   @default(0)
  supportPhone          String?
  supportEmail          String?
  supportWhatsapp       String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  stage                 Stage                 @relation(fields: [stageId], references: [id], onDelete: Cascade)
  units                 Unit[]
  books                 Book[]
  teacherGrades         TeacherGrade[]
  users                 User[]
  competitions          Competition[]         @relation("CompetitionGrade")
  liveSessions          LiveSession[]
  teacherAvailabilities TeacherAvailability[]
  aiKnowledgeSources    AiKnowledgeSource[]
  gradeSchedule         GradeSchedule?

  @@index([stageId])
  @@index([displayOrder])
  @@map("grades")
}

model GradeSchedule {
  id        String   @id @default(uuid()) @db.Uuid
  gradeId   String   @db.Uuid
  days      Int[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  grade     Grade    @relation(fields: [gradeId], references: [id], onDelete: Cascade)

  @@unique([gradeId])
  @@map("grade_schedules")
}

model AcademicYear {
  id           String        @id @default(uuid()) @db.Uuid
  name         String        @unique
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  terms        Term[]
  units        Unit[]
  users        User[]
  competitions Competition[] @relation("CompetitionAcademicYear")

  @@map("academic_years")
}

model Term {
  id                 String              @id @default(uuid()) @db.Uuid
  name               String
  academicYearId     String              @db.Uuid
  displayOrder       Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  academicYear       AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  books              Book[]
  units              Unit[]
  users              User[]
  competitions       Competition[]       @relation("CompetitionTerm")
  aiKnowledgeSources AiKnowledgeSource[]

  @@index([academicYearId])
  @@map("terms")
}

model Book {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  gradeId   String   @db.Uuid
  termId    String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  grade     Grade    @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  term      Term     @relation(fields: [termId], references: [id], onDelete: Cascade)
  units     Unit[]

  @@index([gradeId])
  @@index([termId])
  @@map("books")
}

model TeacherGrade {
  userId    String   @db.Uuid
  gradeId   String   @db.Uuid
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  grade     Grade    @relation(fields: [gradeId], references: [id], onDelete: Cascade)

  @@id([userId, gradeId])
  @@index([gradeId])
  @@map("teacher_grades")
}

model Unit {
  id                String        @id @default(uuid()) @db.Uuid
  title             String
  description       String?
  unitType          UnitType      @default(UNIT)
  gradeId           String        @db.Uuid
  displayOrder      Int           @default(0)
  isPremium         Boolean       @default(false)
  lockedOverride    Boolean?
  published         Boolean       @default(false)
  academicYearId    String?       @db.Uuid
  termId            String?       @db.Uuid
  educationalSystem String?
  bookId            String?       @db.Uuid
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  lessons           Lesson[]
  grade             Grade         @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  academicYear      AcademicYear? @relation(fields: [academicYearId], references: [id])
  term              Term?         @relation(fields: [termId], references: [id])
  book              Book?         @relation(fields: [bookId], references: [id])
  assessments       Assessment[]
  unitCertificates  UnitCertificate[]

  @@index([gradeId])
  @@index([displayOrder])
  @@index([unitType])
  @@index([academicYearId])
  @@index([termId])
  @@index([educationalSystem])
  @@index([bookId])
  @@map("units")
}

model Lesson {
  id                  String               @id @default(uuid()) @db.Uuid
  title               String
  unitId              String               @db.Uuid
  displayOrder        Int                  @default(0)
  estimatedDuration   Int                  @default(0)
  isPremium           Boolean              @default(false)
  lockedOverride      Boolean?
  published           Boolean              @default(false)
  isHidden            Boolean              @default(false)
  sequentialMode      Boolean              @default(true)
  homeworkEnabled     Boolean              @default(false)
  quizEnabled         Boolean              @default(false)
  passingScore        Int                  @default(70)
  maxAttempts         Int                  @default(3)
  xpReward            Int                  @default(100)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  homework            Homework?
  document            LessonDocument?
  progress            LessonProgress[]
  settings            LessonSettings?
  videos              LessonVideo[]
  vocabulary          LessonVocabulary[]
  vocabularySections  VocabularySection[]
  vocabularyRelations VocabularyRelation[]
  questionGroups      QuestionGroup[]
  questions           Question[]
  unit                Unit                 @relation(fields: [unitId], references: [id], onDelete: Cascade)
  quiz                Quiz?
  assessments         Assessment[]
  savedDocuments      SavedDocument[]
  liveSessions        LiveSession[]

  @@index([unitId])
  @@index([displayOrder])
  @@map("lessons")
}

model QuestionGroup {
  id           String     @id @default(uuid()) @db.Uuid
  lessonId     String     @db.Uuid
  title        String
