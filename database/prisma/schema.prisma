}

model LiveBooking {
  id                    String            @id @default(uuid()) @db.Uuid
  sessionId             String            @db.Uuid
  studentId             String            @db.Uuid
  subscriptionId        String?           @db.Uuid
  status                LiveBookingStatus @default(CONFIRMED)
  rescheduleRequestedAt DateTime?
  rescheduleReason      String?
  rescheduleStatus      LiveBookingRescheduleStatus?
  rescheduleResolvedAt  DateTime?
  rescheduleResolvedById String?          @db.Uuid
  cancelledAt           DateTime?
  cancelReason          String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  session      LiveSession              @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student      User                     @relation("LiveBookingStudent", fields: [studentId], references: [id], onDelete: Cascade)
  subscription LiveSubscription?        @relation(fields: [subscriptionId], references: [id])
  rescheduleResolvedBy User?            @relation("LiveBookingRescheduleResolver", fields: [rescheduleResolvedById], references: [id], onDelete: SetNull)

  @@unique([sessionId, studentId])
  @@index([sessionId])
  @@index([studentId])
  @@index([studentId, status])
  @@index([sessionId, status])
  @@index([rescheduleStatus])
  @@map("live_bookings")
}

/// Sellable live-class plan. The dynamic replacement for the hardcoded product
/// catalog: administrators add, edit, deactivate or delete plans at runtime.
/// `type` drives the booking kind (see LivePricingPlanType).
model LivePricingPlan {
  id           String             @id @default(uuid()) @db.Uuid
  code         String             @unique
  name         String
  short        String
  description  String
  type         LivePricingPlanType
  price        Int
  sessionCount Int                @default(1)
  benefits     String[]           @default([])
  isActive     Boolean            @default(true)
  sortOrder    Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([type, isActive])
  @@map("live_pricing_plans")
}

model LiveSubscription {
  id                  String                 @id @default(uuid()) @db.Uuid
  userId              String                 @db.Uuid
  type                LiveSubscriptionType
  packageLabel        String                 @default("4")
  packageSessionCount Int                    @default(4)
  /// Code of the LivePricingPlan that produced this subscription (null for
  /// legacy/bootstrap rows). For custom plans it is the source of truth for
  /// the exact plan identity beyond the generic `type`.
  planCode            String?
  status              LiveSubscriptionStatus @default(ACTIVE)
  teacherId           String?                @db.Uuid
  scheduleId          String?                @db.Uuid
  groupId             String?                @db.Uuid
  sessionsTotal       Int                    @default(0)
  sessionsUsed        Int                    @default(0)
  currentPeriodStart  DateTime
  currentPeriodEnd    DateTime
  nextBillingDate     DateTime?
  autoRenew           Boolean                @default(true)
  price               Int                    @default(0)
  cancelledAt         DateTime?
  cancelReason        String?
  suspendedAt         DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  deletedAt           DateTime?

  user     User          @relation("LiveSubscriptionHolder", fields: [userId], references: [id], onDelete: Cascade)
  teacher  User?         @relation("LiveSubscriptionTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  schedule StudySchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  bookings LiveBooking[]

  @@index([userId])
  @@index([userId, status])
  @@index([teacherId])
  @@index([scheduleId])
  @@index([planCode])
  @@map("live_subscriptions")
}

model LiveWaitingList {
  id         String              @id @default(uuid()) @db.Uuid
  sessionId  String              @db.Uuid
  studentId  String              @db.Uuid
  status     LiveWaitingListStatus @default(WAITING)
  position   Int                 @default(0)
  joinedAt   DateTime            @default(now())
  promotedAt DateTime?
  cancelledAt DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student User        @relation("LiveWaitingListStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([sessionId, status])
  @@index([sessionId, joinedAt])
  @@index([studentId])
  @@map("live_waiting_lists")
}

model LiveAttendance {
  id              String               @id @default(uuid()) @db.Uuid
  sessionId       String               @db.Uuid
  studentId       String               @db.Uuid
  status          LiveAttendanceStatus
  joinedAt        DateTime?
  leftAt          DateTime?
  durationMinutes Int?
  markedBy        String               @default("AUTO")
  markedById      String?              @db.Uuid
  device          String?
  ip              String?
  notes           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student User        @relation("LiveAttendanceStudent", fields: [studentId], references: [id], onDelete: Cascade)
  marker  User?       @relation("LiveAttendanceMarker", fields: [markedById], references: [id])

  @@unique([sessionId, studentId])
  @@index([sessionId])
  @@index([studentId])
  @@map("live_attendance")
}

model TeacherAvailability {
  id            String          @id @default(uuid()) @db.Uuid
  teacherId     String          @db.Uuid
  scheduleId    String?         @db.Uuid
  dayOfWeek     Int
  startTime     DateTime
  endTime       DateTime
  gradeId       String?         @db.Uuid
  maxStudents   Int             @default(1)
  type          LiveSessionType @default(PRIVATE)
  isRecurring   Boolean         @default(true)
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?

  teacher  User              @relation("TeacherAvailabilityTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  schedule StudySchedule?    @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  grade    Grade?            @relation(fields: [gradeId], references: [id])
  sessions LiveSession[]

  @@index([teacherId])
  @@index([teacherId, dayOfWeek])
  @@index([scheduleId])
  @@map("teacher_availability")
}

model TeacherDateBlock {
  id          String    @id @default(uuid()) @db.Uuid
  teacherId   String    @db.Uuid
  blockedDate DateTime
  reason      String?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  teacher User @relation("TeacherDateBlockTeacher", fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, blockedDate])
  @@index([teacherId])
  @@map("teacher_date_blocks")
}

model TeacherLiveSettings {
  id                String          @id @default(uuid()) @db.Uuid
  teacherId         String          @unique @db.Uuid
  defaultMeetingUrl String?
  meetingPassword   String?
  meetingProvider   MeetingProvider @default(EXTERNAL_URL)
  allowOverride     Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  teacher User @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@map("teacher_live_settings")
}

/// Recurring study schedule created by a teacher. A schedule has one day-row in
/// TeacherAvailability per weekday (e.g. Saturday + Tuesday). Group schedules act
/// as bookable groups (capacity = maxStudents); private schedules hold one
/// student per time slot.
model StudySchedule {
  id          String          @id @default(uuid()) @db.Uuid
  teacherId   String          @db.Uuid
  name        String
  type        LiveSessionType @default(PRIVATE)
  /// Group capacity; private schedules use 1 (one student per slot)
  maxStudents Int             @default(1)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  teacher       User                  @relation("StudyScheduleTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  days          TeacherAvailability[]
  subscriptions LiveSubscription[]

  @@index([teacherId])
  @@index([teacherId, isActive])
  @@index([type])
  @@map("study_schedules")
}

model SupportTicket {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @db.Uuid
  userRole        String
  category        String    @default("GENERAL")
  priority        String    @default("MEDIUM")
  status          String    @default("OPEN")
  subject         String
  description     String
  assignedAgentId String?   @db.Uuid
  resolution      String?
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user          User             @relation("SupportTicketCreator", fields: [userId], references: [id], onDelete: Cascade)
  assignedAgent User?            @relation("SupportTicketAgent", fields: [assignedAgentId], references: [id])
  messages      SupportMessage[]

  @@index([userId])
  @@index([status])
  @@index([assignedAgentId])
  @@map("support_tickets")
}

model SupportMessage {
  id         String   @id @default(uuid()) @db.Uuid
  ticketId   String   @db.Uuid
  senderId   String   @db.Uuid
  senderRole String
  body       String
  internal   Boolean  @default(false)
  createdAt  DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User          @relation("SupportMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("support_messages")
}

/// Admin-defined transfer numbers for manual payment (InstaPay, e-wallet, etc.)
model PaymentTransferNumber {
  id          String   @id @default(uuid()) @db.Uuid
  /// "INSTAPAY", "WALLET"
  gateway     String
  label       String
  number      String
  accountName String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("payment_transfer_numbers")
}

/// Student-submitted manual payment orders (proof of transfer)
model ManualPaymentOrder {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  packageId      String    @db.Uuid
  amount         Int
  coinAmount     Int
  gateway        String
  transferNumber String
  senderNumber   String
  transactionRef String
  screenshot     String?
  status         String    @default("PENDING")
  adminNote      String?
  reviewedById   String?   @db.Uuid
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  package    CoinPackage @relation(fields: [packageId], references: [id])
  reviewedBy User?       @relation("ManualPaymentReviewer", fields: [reviewedById], references: [id])

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("manual_payment_orders")
}

/// Auditable refund ledger tied to a successful payment.
/// Mirrors the movement-ledger pattern (XPTransaction) so a refund is a first-class record
/// rather than a bare Payment.status flip.
model LiveRefund {
  id            String         @id @default(uuid()) @db.Uuid
  paymentId     String         @db.Uuid
  userId        String         @db.Uuid
  amount        Int
  currency      String         @default("EGP")
  reason        String?
  status        LiveRefundStatus @default(PENDING)
  processedById String?        @db.Uuid
  processedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  payment      Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  user         User    @relation("LiveRefundUser", fields: [userId], references: [id], onDelete: Cascade)
  processedBy  User?   @relation("LiveRefundProcessor", fields: [processedById], references: [id], onDelete: SetNull)

  @@unique([paymentId])
  @@index([userId])
  @@index([userId, status])
  @@index([status])
  @@index([createdAt])
  @@map("live_refunds")
}

/// Admin global settings for each notification type (which types are active, which channels)
model NotificationConfig {
  id          String   @id @default(uuid()) @db.Uuid
  /// Unique key: "live_session_reminder", "homework_reminder", "lesson_reminder", "report_ready", "payment_receipt", "achievement", "teacher_announcement"
  key         String   @unique
  /// Arabic label shown in admin panel
  label       String
  description String?
  /// Default channel: "IN_APP", "WHATSAPP", "PUSH", "EMAIL"
  channel     String   @default("IN_APP")
  isEnabled   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("notification_configs")
}

/// Pre-defined message templates for notifications
model NotificationTemplate {
  id         String   @id @default(uuid()) @db.Uuid
  /// Unique key matching a NotificationConfig key
  key        String   @unique
  title      String
  message    String
  channel    String   @default("IN_APP")
  isEditable Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("notification_templates")
}

/// WhatsApp API configuration (singleton row)
model WhatsAppConfig {
  id            String   @id @default(uuid()) @db.Uuid
  provider      String   @default("twilio")
  accountSid    String?
  authToken     String?
  phoneNumber   String?
  apiKey        String?
  apiUrl        String?
  isEnabled     Boolean  @default(false)
  webhookSecret String?
  updatedAt     DateTime @updatedAt

  @@map("whatsapp_configs")
}

/// Log of sent WhatsApp messages
model WhatsAppMessage {
  id          String    @id @default(uuid()) @db.Uuid
  to          String
  message     String
  templateKey String?
  status      String    @default("PENDING")
  externalId  String?
  error       String?
  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([status])
  @@index([createdAt])
  @@map("whatsapp_messages")
}

// ── Social Links ─────────────────────────────────────────────────────
model SocialLink {
