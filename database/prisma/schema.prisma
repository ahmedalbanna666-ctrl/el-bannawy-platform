/// Represents a live class session with a teacher and students
model LiveSession {
  id                 String            @id @default(uuid()) @db.Uuid
  title              String
  description        String?
  teacherId          String            @db.Uuid
  gradeId            String?           @db.Uuid
  lessonId           String?           @db.Uuid
  /// Logical course/subject reference. In this platform the course is the grade;
  /// stored as a plain indexed uuid because no dedicated Course table exists.
  courseId           String?           @db.Uuid
  availabilitySlotId String?           @db.Uuid
  date               DateTime
  startTime          DateTime
  endTime            DateTime
  durationMinutes    Int               @default(60)
  maxStudents        Int?
  availableSeats     Int?
  status             LiveSessionStatus @default(DRAFT)
  type               LiveSessionType   @default(PRIVATE)
  meetingUrl         String?
  meetingPassword    String?
  meetingProvider    MeetingProvider   @default(EXTERNAL_URL)
  zoomMeetingId      String?
  zoomPassword       String?
  zoomJoinUrl        String?
  waitingRoom        Boolean           @default(true)
  autoRecord         Boolean           @default(false)
  notes              String?
  publishedAt        DateTime?
  scheduledAt        DateTime?
  openedAt           DateTime?
  liveAt             DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancelReason       String?
  archivedAt         DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  deletedAt          DateTime?

  teacher          User                    @relation("LiveSessionsAsTeacher", fields: [teacherId], references: [id])
  grade            Grade?                  @relation(fields: [gradeId], references: [id])
  lesson           Lesson?                 @relation(fields: [lessonId], references: [id])
  availabilitySlot TeacherAvailability?    @relation(fields: [availabilitySlotId], references: [id])
  bookings         LiveBooking[]
  attendance       LiveAttendance[]
  announcements    LiveAnnouncement[]
  controlLogs      LiveSessionControlLog[]
  waitlist         LiveWaitingList[]

  @@index([teacherId])
  @@index([gradeId])
  @@index([lessonId])
  @@index([courseId])
  @@index([status])
  @@index([date])
  @@index([availabilitySlotId])
  @@index([teacherId, date])
  @@map("live_sessions")
}

model LiveAnnouncement {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @db.Uuid
